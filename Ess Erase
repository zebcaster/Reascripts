-- Debug toggle
local showDebug = false
local function debugMsg(msg) if showDebug then reaper.ShowConsoleMsg(msg) end end

-- Persistent State
local function getExtState(key, default)
  local state = reaper.GetExtState(SCRIPT_NAME, key)
  if state == "" then return default end
  local num = tonumber(state)
  if num ~= nil then return num end
  return state
end

local function setExtState(key, value)
  reaper.SetExtState(SCRIPT_NAME, key, tostring(value), true)
end
local function loadSettings()
  local freqLow = getExtState("freqLow", DEFAULT_FREQ_LOW)
  local freqHigh = getExtState("freqHigh", DEFAULT_FREQ_HIGH)
  local thresholdRatio = getExtState("thresholdRatio", DEFAULT_THRESHOLD_RATIO)
  local reduction = getExtState("reduction", DEFAULT_REDUCTION)
  local attackTime = getExtState("attackTime", DEFAULT_ATTACK_TIME)
  local releaseTime = getExtState("releaseTime", DEFAULT_RELEASE_TIME)
  local numBars = getExtState("numBars", DEFAULT_NUM_BARS)
  local minDB = getExtState("minDB", DEFAULT_MIN_DB)
  local maxDB = getExtState("maxDB", DEFAULT_MAX_DB)
  local curvePower = getExtState("curvePower", DEFAULT_CURVE_POWER)
  local detectionMs = getExtState("detectionMs", DEFAULT_DETECTION_MS)
  local envelopeMs = getExtState("envelopeMs", DEFAULT_ENVELOPE_MS)
  local sibilanceOpacity = getExtState("sibilanceOpacity", DEFAULT_SIBILANCE_OPACITY)
  local showTooltips = getExtState("showTooltips", 1) == 1
  local rawWaveformOpacity = getExtState("rawWaveformOpacity", DEFAULT_RAW_WAVEFORM_OPACITY)
  local numFreqBins = getExtState("numFreqBins", DEFAULT_FREQ_PRECISION)
  local numTimeBins = getExtState("numTimeBins", DEFAULT_TIME_PRECISION)
  local freqLogScaling = getExtState("freqLogScaling", DEFAULT_FREQ_LOG_SCALING)
  
  return freqLow, freqHigh, thresholdRatio, reduction, attackTime, releaseTime, numBars, minDB, maxDB, curvePower, detectionMs, envelopeMs, sibilanceOpacity, showTooltips, rawWaveformOpacity, numFreqBins, numTimeBins, freqLogScaling
end

local function saveSettings(freqLow, freqHigh, thresholdRatio, reduction, attackTime, releaseTime, detectionMs, envelopeMs, sibilanceOpacity, showTooltips, rawWaveformOpacity, numFreqBins, numTimeBins, freqLogScaling)
  setExtState("freqLow", freqLow)
  setExtState("freqHigh", freqHigh)
