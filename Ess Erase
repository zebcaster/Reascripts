  setExtState("showTooltips", showTooltips and 1 or 0)
  setExtState("rawWaveformOpacity", rawWaveformOpacity)
  setExtState("numFreqBins", numFreqBins)
  setExtState("numTimeBins", numTimeBins)
  setExtState("freqLogScaling", freqLogScaling)
end

local cachedItemRMS_dB = 0  -- Cached RMS of current item in dB

-- Conversion
local function dBToLinear(dB)
  if not dB or dB ~= dB then return 1.0 end
  return 10^(dB/20)
end

local function linearTodB(linear)
  if not linear or linear ~= linear then return -150 end
  if linear <= 0.00001 then return -150 end
  return 20 * math.log10(linear)
end

-- Helper function to detect channel count from source
local function getSourceChannelCount(take)
  local src = reaper.GetMediaItemTake_Source(take)
  if not src then return 1 end
  local numChannels = reaper.GetMediaSourceNumChannels(src)
  return math.max(1, numChannels)
end

-- ===== Audio accessor mgmt =====
local audioAccessors, audioBuffers = {}, {}

local function getAudioAccessor(take)
  if not take then return nil end
  if audioAccessors[take] then return audioAccessors[take] end
  local aa = reaper.CreateTakeAudioAccessor(take)
  audioAccessors[take] = aa
  return aa
end

local function releaseAudioAccessor(take)
  if audioAccessors[take] then reaper.DestroyAudioAccessor(audioAccessors[take]); audioAccessors[take] = nil end
  if audioBuffers[take] then audioBuffers[take] = nil end
end

local function getAudioBuffer(take, size)
  if not audioBuffers[take] or #audioBuffers[take] < size then audioBuffers[take] = reaper.new_array(size) end
  return audioBuffers[take]
end

-- Helper: unified accessor bounds (PROJECT TIME)
local function get_accessor_bounds(take)
  if not take then return nil end
  local aa = getAudioAccessor(take)
  if not aa then return nil end
  local aaStart = reaper.GetAudioAccessorStartTime(aa)
  local aaEnd   = reaper.GetAudioAccessorEndTime(aa)
  local src     = reaper.GetMediaItemTake_Source(take)
  local sr      = reaper.GetMediaSourceSampleRate(src)
  local itemLen = math.max(0, aaEnd - aaStart)
  return aa, aaStart, aaEnd, sr, itemLen
end

local function getItemRMS(take, item)
  local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
  if not aa or samplerate <= 0 or itemLen <= 0 then return -150 end
  
  local itemVolume = reaper.GetMediaItemInfo_Value(item, "D_VOL")
  local numChannels = getSourceChannelCount(take)
  local totalEnergy = 0
  local totalSamples = 0
  local chunkSize = math.min(100000, samplerate)
  local numChunks = math.ceil(itemLen * samplerate / chunkSize)
  
  for chunkIdx = 0, numChunks - 1 do
    local readTime = aaStart + (chunkIdx * chunkSize / samplerate)
    local buf = getAudioBuffer(take, chunkSize * numChannels * 2)
    buf.clear()
    local read = reaper.GetAudioAccessorSamples(aa, samplerate, numChannels, readTime, chunkSize, buf)

    if read > 0 then
      local t = buf.table()
      for j = 1, read, numChannels * 2 do
        local sample = t[j] * itemVolume
        totalEnergy = totalEnergy + (sample * sample)
        totalSamples = totalSamples + 1
      end
    end
  end
  
  if totalSamples > 0 then
    return linearTodB(math.sqrt(totalEnergy / totalSamples))
  end
  return -150
end

-- ===== Real FFT-based sibilance detection =====
local function detectSibilance(take, item, freqLow, freqHigh, thresholdRatio, detectionMs)
  local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
  if not aa or samplerate <= 0 or itemLen <= 0 then return nil end

  local itemVolume = reaper.GetMediaItemInfo_Value(item, "D_VOL")
  local numChannels = getSourceChannelCount(take)
  
  local windowSize = math.max(0.01, (detectionMs or 10) / 1000)
  local numWindows = math.ceil(itemLen / windowSize)
  
  local hopSize = math.floor(samplerate * windowSize)
  local fftSize = 2048
  local sibilanceMap = {}
  
  -- Will accumulate RMS during the main loop
  local totalEnergy = 0
  local totalSamples = 0
  
  -- Scan through audio
  for i = 0, numWindows - 1 do
    local readTime = aaStart + (i * windowSize)
    local numSamples = math.min(hopSize, 100000)
    
    if numSamples > 0 then
      local buf = getAudioBuffer(take, numSamples * numChannels * 2)
      buf.clear()
      local read = reaper.GetAudioAccessorSamples(aa, samplerate, numChannels, readTime, numSamples, buf)
      
      if read > 0 then
        local t = buf.table()
        
        -- Accumulate energy for RMS calculation
        for j = 1, read, numChannels * 2 do
          local sample = t[j] * itemVolume
          totalEnergy = totalEnergy + (sample * sample)
          totalSamples = totalSamples + 1
        end
        
        local fftData = reaper.new_array(fftSize)
        fftData.clear()
        
        local fillIdx = 1
        for j = 1, math.min(numSamples, fftSize) do
          local sample = t[(j - 1) * numChannels + 1] * itemVolume
          fftData[j] = sample
          fillIdx = j + 1
        end
        
        fftData.fft_real(fftSize, true, 1)
        
        local freqRes = samplerate / fftSize
        local binLow = math.floor(freqLow / freqRes) + 1
        local binHigh = math.floor(freqHigh / freqRes) + 1
        binLow = math.max(1, math.min(binLow, fftSize / 2))
        binHigh = math.max(binLow, math.min(binHigh, fftSize / 2))
        
        local energy = 0
        for bin = binLow, binHigh do
          local realIdx = bin * 2 - 1
          local imagIdx = bin * 2
          if realIdx <= fftSize and imagIdx <= fftSize then
            local real = fftData[realIdx]
            local imag = fftData[imagIdx]
            energy = energy + (real * real + imag * imag)
          end
        end
        
        local binCount = math.max(1, binHigh - binLow + 1)
        energy = math.sqrt(energy / binCount) / fftSize
        local energyDB = linearTodB(energy)
        
        -- Calculate actual threshold using ratio: RMS / ratio = threshold
        local actualThreshold = cachedItemRMS_dB / thresholdRatio
        local isSibilant = (energyDB > actualThreshold)
        sibilanceMap[i + 1] = {energy=energy, isSibilant=isSibilant, energyDB=energyDB}
      else
        sibilanceMap[i + 1] = {energy=0, isSibilant=false, energyDB=-150}
      end
    end
  end
  
  -- Calculate RMS from accumulated energy
  if totalSamples > 0 then
    local rmsLinear = math.sqrt(totalEnergy / totalSamples)
    cachedItemRMS_dB = linearTodB(rmsLinear)
  end
  
  releaseAudioAccessor(take)
  return sibilanceMap, itemLen, windowSize
end

-- ===== Spectrogram computation (full spectrum) =====
local function computeSpectrogram(take, item, numFreqBins, numTimeBins, freqLow, freqHigh)
  local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
  if not aa or samplerate <= 0 or itemLen <= 0 then return nil end

  local itemVolume = reaper.GetMediaItemInfo_Value(item, "D_VOL")
  local numChannels = getSourceChannelCount(take)
  
  local fftSize = 4096
  local hopSize = math.floor(itemLen / numTimeBins * samplerate)
  hopSize = math.max(512, math.min(hopSize, samplerate))
  
  local spectrogram = {}
  
  for timeIdx = 1, numTimeBins do
    local readTime = aaStart + ((timeIdx - 1) / numTimeBins) * itemLen
    local numSamples = math.min(hopSize, 100000)
    
    if numSamples > 0 then
      local buf = getAudioBuffer(take, numSamples * numChannels * 2)
      buf.clear()
      local read = reaper.GetAudioAccessorSamples(aa, samplerate, numChannels, readTime, numSamples, buf)
      
      if read > 0 then
        local fftData = reaper.new_array(fftSize)
        fftData.clear()
        
        local t = buf.table()
        for j = 1, math.min(numSamples, fftSize) do
          local sample = t[(j - 1) * numChannels + 1] * itemVolume
          fftData[j] = sample
        end
        
        fftData.fft_real(fftSize, true, 1)
        
        local timeSlice = {}
        local nyquist = samplerate / 2
        
        -- Map entire spectrum from 0 to Nyquist
        for freqIdx = 1, numFreqBins do
          local binIdx = math.floor((freqIdx - 1) / (numFreqBins - 1) * (fftSize / 2 - 1)) + 1
          binIdx = math.max(1, math.min(binIdx, fftSize / 2))
          
          local realIdx = binIdx * 2 - 1
          local imagIdx = binIdx * 2
          
          if realIdx > 0 and realIdx <= fftSize and imagIdx > 0 and imagIdx <= fftSize then
            local real = fftData[realIdx]
            local imag = fftData[imagIdx]
            if real and imag then
             
              --local magnitude = math.sqrt(real * real + imag * imag)
              --magnitude = (magnitude / fftSize) * 2  -- Normalize and account for negative frequencies
              --magnitude = magnitude * 10  -- Boost to see more dynamic range
              --local magnitudeDB = linearTodB(magnitude)
              
              local magnitude = math.sqrt(real * real + imag * imag)
              -- For a real FFT with proper windowing, normalize by half the FFT size
              magnitude = (magnitude / fftSize)-- * 10--magnitude / (fftSize / 2)
              local magnitudeDB = linearTodB(magnitude)
              
              timeSlice[freqIdx] = magnitudeDB
            else
              timeSlice[freqIdx] = -150
            end
          else
            timeSlice[freqIdx] = -150
          end
        end
        
        spectrogram[timeIdx] = timeSlice
      else
        local timeSlice = {}
        for freqIdx = 1, numFreqBins do
          timeSlice[freqIdx] = -150
        end
        spectrogram[timeIdx] = timeSlice
      end
    end
  end
  
  releaseAudioAccessor(take)
  return spectrogram
end

-- ===== Waveform with sibilance coloring =====
local function getWaveformWithSibilance(item, numSamples, sibilanceMap, detectionWindowSize, reduction)
  local take = reaper.GetActiveTake(item)
  if not take or reaper.TakeIsMIDI(take) then return nil, nil end
  local itemVolume = reaper.GetMediaItemInfo_Value(item, "D_VOL")

  local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
  if not aa or samplerate <= 0 or itemLen <= 0 then if take then releaseAudioAccessor(take) end; return nil, nil end

  local numChannels = getSourceChannelCount(take)
  local data = {}
  local waveformWindowSize = itemLen / numSamples
  local reductionLin = dBToLinear(reduction)

  for i = 0, numSamples - 1 do
    local readTime = aaStart + (i * waveformWindowSize)
    local numSamps = math.min(math.floor(samplerate * waveformWindowSize), 1000000)
    
    -- Determine which window this sample falls into for sibilance detection
    local itemTime = (readTime - aaStart)
    local sibWindow = math.floor(itemTime / detectionWindowSize) + 1
    local isSibilant = false
    if sibilanceMap and sibWindow >= 1 and sibWindow <= #sibilanceMap then
      isSibilant = sibilanceMap[sibWindow].isSibilant
    end
    
    if numSamps <= 0 then
      data[i+1] = {pos=0, neg=0, isSibilant=isSibilant}
    else
      local buf = getAudioBuffer(take, numSamps * numChannels * 2)
      buf.clear()
      local read = reaper.GetAudioAccessorSamples(aa, samplerate, numChannels, readTime, numSamps, buf)
      if read > 0 then
        local pos, neg, t = 0, 0, buf.table()
        for j = 1, #t, numChannels * 2 do
          local s = t[j] * itemVolume
          -- Apply reduction if sibilant
          if isSibilant then
            s = s * reductionLin
          end
          if s > pos then pos = s end
          if s < neg then neg = s end
        end
        data[i+1] = {pos=pos, neg=math.abs(neg), isSibilant=isSibilant}
      else
        data[i+1] = {pos=0, neg=0, isSibilant=isSibilant}
      end
    end
  end

  releaseAudioAccessor(take)
  return data, linearTodB(itemVolume)
end

-- ===== Waveform data (raw) =====
local function getRawWaveform(item, numSamples)
  local take = reaper.GetActiveTake(item)
  if not take or reaper.TakeIsMIDI(take) then return nil, 0 end
  local itemVolume = reaper.GetMediaItemInfo_Value(item, "D_VOL")

  local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
  if not aa or samplerate <= 0 or itemLen <= 0 then if take then releaseAudioAccessor(take) end; return nil, 0 end

  local numChannels = getSourceChannelCount(take)
  local data = {}
  local windowSize = itemLen / numSamples

  for i = 0, numSamples - 1 do
    local readTime = aaStart + (i * windowSize)
    local numSamps = math.min(math.floor(samplerate * windowSize), 1000000)
    if numSamps <= 0 then
      data[i+1] = {pos=0, neg=0}
    else
      local buf = getAudioBuffer(take, numSamps * numChannels * 2)
      buf.clear()
      local read = reaper.GetAudioAccessorSamples(aa, samplerate, numChannels, readTime, numSamps, buf)
      if read > 0 then
        local pos, neg, t = 0, 0, buf.table()
        for j = 1, #t, numChannels * 2 do
          local s = t[j] * itemVolume
          if s > pos then pos = s end
          if s < neg then neg = s end
        end
        data[i+1] = {pos=pos, neg=math.abs(neg)}
      else
        data[i+1] = {pos=0, neg=0}
      end
    end
  end

  releaseAudioAccessor(take)
  return data, linearTodB(itemVolume)
end

-- ===== Drawing helpers =====
local function drawWaveform(drawList, rawData, processedData, x, y, width, height, minDB, maxDB, curvePower, zoomLevel, zoomCenter, sibilanceOpacity, rawOpacity)
  if not processedData or #processedData == 0 then return end
  local centerY = y + height / 2
  local dbRange = maxDB - minDB

  local totalSamples = #processedData
  local visibleSamples = math.max(50, math.floor(totalSamples / zoomLevel))
  local startSample = math.max(1, math.min(totalSamples - visibleSamples, math.floor(zoomCenter * totalSamples - visibleSamples / 2)))
  local endSample = math.min(totalSamples, startSample + visibleSamples)
  local barWidth = width / visibleSamples

  reaper.ImGui_DrawList_AddLine(drawList, x, centerY, x + width, centerY, 0x808080FF, 1)

  local function dbToHeight(db, maxHeight)
    if db <= minDB then return 0 end
    if db >= maxDB then return maxHeight end
    local normalized = (db - minDB) / dbRange
    local curved = normalized ^ curvePower
    return curved * maxHeight
  end

  -- Draw raw waveform in background at low opacity
  local rawOpacityHex = math.floor(rawOpacity * 2.55)
  local rawColor = 0x40808000 + rawOpacityHex

  if rawData and #rawData > 0 and rawOpacity > 0 then
    for i = startSample, endSample do
      if i <= #rawData then
        local barX = x + (i - startSample) * barWidth
        local posDB = linearTodB(rawData[i].pos)
        local negDB = linearTodB(rawData[i].neg)
        local posH = dbToHeight(posDB, height / 2)
        local negH = dbToHeight(negDB, height / 2)
        if posH > 0 then reaper.ImGui_DrawList_AddRectFilled(drawList, barX, centerY - posH, barX + barWidth + 1, centerY, rawColor) end
        if negH > 0 then reaper.ImGui_DrawList_AddRectFilled(drawList, barX, centerY, barX + barWidth + 1, centerY + negH, rawColor) end
      end
    end
  end

  -- Draw processed waveform on top
  for i = startSample, endSample do
    if i <= #processedData then
      local barX = x + (i - startSample) * barWidth
      local posDB = linearTodB(processedData[i].pos)
      local negDB = linearTodB(processedData[i].neg)
      local posH = dbToHeight(posDB, height / 2)
      local negH = dbToHeight(negDB, height / 2)
      
      -- Choose color based on sibilance
      local waveColor = 0x4080FFFF  -- Normal blue
      if processedData[i].isSibilant then
        -- Sibilant: orange with opacity control
        local sibOpacityHex = math.floor(sibilanceOpacity * 2.55)
        waveColor = 0xFFA500FF - ((255 - sibOpacityHex) * 256)
      end
      
      if posH > 0 then reaper.ImGui_DrawList_AddRectFilled(drawList, barX, centerY - posH, barX + barWidth + 1, centerY, waveColor) end
      if negH > 0 then reaper.ImGui_DrawList_AddRectFilled(drawList, barX, centerY, barX + barWidth + 1, centerY + negH, waveColor) end
    end
  end

  local dbMarks = {0, -6, -12, -18, -24, -30, -40, -60, -80, -100, -120}
  for _, db in ipairs(dbMarks) do
    if db >= minDB and db <= maxDB then
      local yTop = centerY - dbToHeight(db, height / 2)
      local yBot = centerY + dbToHeight(db, height / 2)
      reaper.ImGui_DrawList_AddLine(drawList, x - 5, yTop, x, yTop, 0xFFFFFF80, 1)
      reaper.ImGui_DrawList_AddLine(drawList, x - 5, yBot, x, yBot, 0xFFFFFF80, 1)
    end
  end

  if zoomLevel > 1.01 then
    reaper.ImGui_DrawList_AddText(drawList, x + 5, y + 5, 0xFFFFFFFF, string.format("Zoom: %.1fx", zoomLevel))
  end
end

-- Helper function to convert a color value to hex string for display
local function colorToHexString(color)
  local a = (color >> 24) & 0xFF
  local b = (color >> 16) & 0xFF
  local g = (color >> 8) & 0xFF
  local r = color & 0xFF
  
  return string.format("0x%08X", color)
end

-- Spectrogram drawing with logarithmic frequency scaling
local function drawSpectrogram(drawList, spectrogram, x, y, w, h, minDB, maxDB, freqLow, freqHigh, zoomLevel, zoomCenter, mouseX, mouseY, freqLogScaling)
  if not spectrogram or #spectrogram == 0 then return end
  
  reaper.ImGui_DrawList_AddRectFilled(drawList, x, y, x + w, y + h, 0x1A1A1AFF)
  
  local numTimeBins = #spectrogram
  local numFreqBins = spectrogram[1] and #spectrogram[1] or 0
  if numFreqBins == 0 then return end
  
  local dbRange = maxDB - minDB
  if dbRange <= 0 then dbRange = 1 end
  
  local nyquist = 24000  -- Adjust based on your sample rate
  
  -- Apply zoom/pan to time dimension
  local visibleTimeBins = math.max(10, math.floor(numTimeBins / zoomLevel))
  local startTimeBin = math.max(1, math.min(numTimeBins - visibleTimeBins, math.floor(zoomCenter * numTimeBins - visibleTimeBins / 2)))
  local endTimeBin = math.min(numTimeBins, startTimeBin + visibleTimeBins)
  
  local barWidth = w / visibleTimeBins
  
  -- Diagnostic: find actual min/max dB values in spectrogram
  local actualMinDB = 0
  local actualMaxDB = -150
  for timeIdx = 1, numTimeBins do
    local timeSlice = spectrogram[timeIdx]
    if timeSlice then
      for freqIdx = 1, numFreqBins do
        local db = timeSlice[freqIdx]
        if db and db > -150 then
          actualMinDB = math.max(actualMinDB, db)
          actualMaxDB = math.min(actualMaxDB, db)
        end
      end
    end
  end
  
  debugMsg(string.format("Spectrogram dB range: actual [%.1f, %.1f], display [%.1f, %.1f]\n", 
    actualMaxDB, actualMinDB, minDB, maxDB))
  
  -- Draw spectrogram
  for timeIdx = startTimeBin, endTimeBin do
    local timeSlice = spectrogram[timeIdx]
    if timeSlice then
      local barX = x + (timeIdx - startTimeBin) * barWidth
      
      for freqBarIdx = 1, numFreqBins do
        -- Map display position to logarithmic frequency
        local normalizedPos = (freqBarIdx - 1) / (numFreqBins - 1)  -- 0 to 1
        
        -- Convert linear position to logarithmic frequency position
        local logPos = (math.exp(normalizedPos * freqLogScaling) - 1) / (math.exp(freqLogScaling) - 1)
        logPos = math.max(0, math.min(1, logPos))
        
        -- Map back to frequency bin index in the spectrogram data
        local freqIdx = math.floor(logPos * (numFreqBins - 1)) + 1
        freqIdx = math.max(1, math.min(numFreqBins, freqIdx))
        
        local db = timeSlice[freqIdx]
        if not db or db < minDB then db = minDB end
        if db > maxDB then db = maxDB end
        
        -- Calculate color based on dB value (RGBA format)
        local color
        if db < -84 then
          local t = (db - minDB) / (-84 - minDB)
          t = math.max(0, math.min(1, t))
          local b = math.floor(255 * t)
          color = (0 << 24) + (0 << 16) + (b << 8) + 0x50
        elseif db < -72 then
          local t = (db - (-84)) / (-72 - (-84))
          t = math.max(0, math.min(1, t))
          local r = math.floor(255 * t)
          local b = 255
          color = (r << 24) + (0 << 16) + (b << 8) + 0xB4
        elseif db < -60 then
          local t = (db - (-72)) / (-60 - (-72))
          t = math.max(0, math.min(1, t))
          local r = 255
          local b = math.floor(255 * (1 - t))
          color = (r << 24) + (0 << 16) + (b << 8) + 0xB4
        elseif db < -48 then
          local t = (db - (-60)) / (-48 - (-60))
          t = math.max(0, math.min(1, t))
          local r = 255
          local g = math.floor(255 * t)
          color = (r << 24) + (g << 16) + (0 << 8) + 0xF0
        elseif db < -36 then
          local t = (db - (-48)) / (-36 - (-48))
          t = math.max(0, math.min(1, t))
          local r = math.floor(255 * (1 - t))
          local g = 255
          color = (r << 24) + (g << 16) + (0 << 8) + 0xFF
        elseif db < -24 then
          local t = (db - (-36)) / (-24 - (-36))
          t = math.max(0, math.min(1, t))
          local g = 255
          local b = math.floor(255 * t)
          color = (0 << 24) + (g << 16) + (b << 8) + 0xFF
        else
          color = (0 << 24) + (255 << 16) + (255 << 8) + 0xFF
        end
        
        local freqBarHeight = h / numFreqBins
        local barY = y + (numFreqBins - freqBarIdx) * freqBarHeight
        
        reaper.ImGui_DrawList_AddRectFilled(drawList, barX, barY, barX + barWidth + 1, barY + freqBarHeight + 1, color)
      end
    end
  end
  
  reaper.ImGui_DrawList_AddRect(drawList, x, y, x + w, y + h, 0x808080FF, 0, 0, 1)
  
  -- Show zoom level indicator
  if zoomLevel > 1.01 then
    reaper.ImGui_DrawList_AddText(drawList, x + 5, y + 5, 0xFFFFFFFF, string.format("Zoom: %.1fx", zoomLevel))
  end
  
  -- Return cursor information if mouse is over spectrogram
  local cursorInfo = nil
  if mouseX and mouseY and mouseX >= x and mouseX <= x + w and mouseY >= y and mouseY <= y + h then
    -- Calculate which time bin the mouse is over
    local relX = (mouseX - x) / w
    local timeIdx = math.floor(relX * visibleTimeBins) + startTimeBin
    timeIdx = math.max(startTimeBin, math.min(endTimeBin, timeIdx))
    
    -- Convert vertical position to logarithmic frequency with sub-pixel precision
    local freqDisplayPos = 1 - ((mouseY - y) / h)  -- Invert because Y increases downward
    local logPos = (math.exp(freqDisplayPos * freqLogScaling) - 1) / (math.exp(freqLogScaling) - 1)
    logPos = math.max(0, math.min(1, logPos))
    
    -- Calculate precise frequency without rounding to bin boundary
    local preciseFreqIdx = logPos * (numFreqBins - 1) + 1
    local freq = (preciseFreqIdx - 1) / (numFreqBins - 1) * nyquist
    
    -- Get the actual bin for dB lookup
    local freqIdx = math.floor(preciseFreqIdx)
    freqIdx = math.max(1, math.min(numFreqBins, freqIdx))
    
    local timeSlice = spectrogram[timeIdx]
    if timeSlice and timeSlice[freqIdx] then
      local db = timeSlice[freqIdx]
      
      -- Calculate color using the same logic as the drawing loop (RGBA format)
      local color
      if db < -84 then
        local t = (db - minDB) / (-84 - minDB)
        t = math.max(0, math.min(1, t))
        local b = math.floor(255 * t)
        color = (0 << 24) + (0 << 16) + (b << 8) + 0x50
      elseif db < -72 then
        local t = (db - (-84)) / (-72 - (-84))
        t = math.max(0, math.min(1, t))
        local r = math.floor(255 * t)
        local b = 255
        color = (r << 24) + (0 << 16) + (b << 8) + 0xB4
      elseif db < -60 then
        local t = (db - (-72)) / (-60 - (-72))
        t = math.max(0, math.min(1, t))
        local r = 255
        local b = math.floor(255 * (1 - t))
        color = (r << 24) + (0 << 16) + (b << 8) + 0xB4
      elseif db < -48 then
        local t = (db - (-60)) / (-48 - (-60))
        t = math.max(0, math.min(1, t))
        local r = 255
        local g = math.floor(255 * t)
        color = (r << 24) + (g << 16) + (0 << 8) + 0xF0
      elseif db < -36 then
        local t = (db - (-48)) / (-36 - (-48))
        t = math.max(0, math.min(1, t))
        local r = math.floor(255 * (1 - t))
        local g = 255
        color = (r << 24) + (g << 16) + (0 << 8) + 0xFF
      elseif db < -24 then
        local t = (db - (-36)) / (-24 - (-36))
        t = math.max(0, math.min(1, t))
        local g = 255
        local b = math.floor(255 * t)
        color = (0 << 24) + (g << 16) + (b << 8) + 0xFF
      else
        color = (0 << 24) + (255 << 16) + (255 << 8) + 0xFF
      end
      
      cursorInfo = { freq = freq, db = db, color = color }
    end
  end
  
  return cursorInfo
end

-- Time ruler drawing
local function drawTimeRuler(drawList, item, x, y, width, height, zoomLevel, zoomCenter, totalSamples, startSample, visibleSamples)
  if not item then return end
  reaper.ImGui_DrawList_AddRectFilled(drawList, x, y, x + width, y + height, 0x0F0F0FF0)

  local take = reaper.GetActiveTake(item)
  if not take then return end

  local aa, aaStart, aaEnd, _, itemLen = get_accessor_bounds(take)
  if not aa then return end

  local itemPos = reaper.GetMediaItemInfo_Value(item, "D_POSITION")
  local startTime = itemPos + (startSample / totalSamples) * itemLen
  local endTime   = itemPos + ((startSample + visibleSamples) / totalSamples) * itemLen
  local timeRange = endTime - startTime

  local divisions = {1, 2, 5, 10, 30, 60, 120, 300, 600}
  local targetDivisions = math.max(3, math.min(10, width / 80))
  local bestDivision = divisions[1]
  for _, div in ipairs(divisions) do
    if timeRange / div <= targetDivisions then bestDivision = div; break end
  end

  local firstMark = math.ceil(startTime / bestDivision) * bestDivision
  for markTime = firstMark, endTime, bestDivision do
    if markTime >= startTime and markTime <= endTime then
      local relX = (markTime - startTime) / timeRange
      local px = x + relX * width
      reaper.ImGui_DrawList_AddLine(drawList, px, y, px, y + height * 0.3, 0xFFFFFFFF, 1)
      local hours = math.floor(markTime / 3600)
      local minutes = math.floor((markTime % 3600) / 60)
      local seconds = markTime % 60
      local timeText
      if hours > 0 then
        timeText = string.format("%d:%02d:%05.2f", hours, minutes, seconds)
      elseif minutes > 0 then
        timeText = string.format("%d:%05.2f", minutes, seconds)
      else
        timeText = string.format("%.2f", seconds)
      end
      local textWidth = #timeText * 7
      reaper.ImGui_DrawList_AddText(drawList, px - textWidth/2, y + height * 0.4, 0xFFFFFFFF, timeText)
    end
  end
end

-- Playhead drawing
local function drawPlayhead(drawList, item, x, y, w, h, zoomLevel, zoomCenter, totalSamples, startSample, visibleSamples)
  if not item then return end
  
  local isPlaying = reaper.GetPlayState() & 1 == 1
  local cursorPos = isPlaying and reaper.GetPlayPosition() or reaper.GetCursorPosition()
  local itemStart = reaper.GetMediaItemInfo_Value(item, "D_POSITION")
  local itemLength = reaper.GetMediaItemInfo_Value(item, "D_LENGTH")
  local itemEnd = itemStart + itemLength
  
  -- Check if cursor is within this item
  if cursorPos >= itemStart and cursorPos <= itemEnd then
    -- Get the take to access audio bounds
    local take = reaper.GetActiveTake(item)
    if not take then return end
    
    local aa, aaStart, aaEnd, _, audioItemLen = get_accessor_bounds(take)
    if not aa then return end
    
    -- Calculate offset within the item (in item time, not project time)
    local itemOffset = cursorPos - itemStart
    
    -- Map item time to waveform sample position
    local samplePos = math.floor((itemOffset / audioItemLen) * totalSamples) + 1
    
    -- Check if sample position is visible in current zoom/pan
    if samplePos >= startSample and samplePos <= startSample + visibleSamples then
      -- Calculate pixel X position on waveform
      local xPos = x + ((samplePos - startSample) / visibleSamples) * w
      
      -- Draw playhead line (bright green, semi-thick)
      reaper.ImGui_DrawList_AddLine(drawList, xPos, y, xPos, y + h, 0x00FF00FF, 2)
      
      -- Optional: Add a subtle glow/highlight effect
      reaper.ImGui_DrawList_AddLine(drawList, xPos, y, xPos, y + h, 0x00FF0044, 4)
    end
  end
end

-- Envelope simplification
local function simplifyEnvelope(env)
  local pointCount = reaper.CountEnvelopePoints(env)
  if pointCount <= 2 then return end
  local pts = {}
  for i = 0, pointCount - 1 do
    local _, time, value, shape, tension, selected = reaper.GetEnvelopePoint(env, i)
    pts[#pts+1] = {time=time, value=value, shape=shape, tension=tension, selected=selected}
  end
  table.sort(pts, function(a,b) return a.time < b.time end)
  local keep = {}
  keep[#keep+1] = pts[1]
  local i = 2
  while i <= #pts do
    local s = i
    local v = pts[i].value
    while i <= #pts and math.abs(pts[i].value - v) < 0.0001 do i = i + 1 end
    local e = i - 1
    if e - s >= 2 then
      keep[#keep+1] = pts[s]; keep[#keep+1] = pts[e]
    else
      for j = s, e do keep[#keep+1] = pts[j] end
    end
  end
  local itemLen = reaper.GetEnvelopeInfo_Value(env, "LENGTH")
  reaper.DeleteEnvelopePointRange(env, -1, itemLen + 1000)
  for _, p in ipairs(keep) do reaper.InsertEnvelopePoint(env, p.time, p.value, p.shape, p.tension, p.selected, true) end
  reaper.Envelope_SortPoints(env)
end

-- Apply de-esser to item
local function applyToItem(item, sibilanceMap, detectionWindowSize, reduction, envelopeMs)
  local ts = reaper.time_precise()
  local take = reaper.GetActiveTake(item)
  if not take or reaper.TakeIsMIDI(take) then return false, 0 end
  
  local env = reaper.GetTakeEnvelopeByName(take, "Volume")
  if not env then
    reaper.Main_OnCommand(reaper.NamedCommandLookup("_S&M_TAKEENVSHOW9"), 0)
    env = reaper.GetTakeEnvelopeByName(take, "Volume")
  end
  if not env then return false, 0 end

  local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
  if not aa or samplerate <= 0 or itemLen <= 0 then if take then releaseAudioAccessor(take) end; return false, 0 end

  reaper.DeleteEnvelopePointRange(env, -1, itemLen + 1000)

  local envelopeResolutionSec = math.max(0.0001, (envelopeMs or 1) / 1000)
  local reductionLin = dBToLinear(reduction)
  
  local numPoints = math.ceil(itemLen / envelopeResolutionSec)

  for i = 0, numPoints do
    local tRel = math.min(i * envelopeResolutionSec, itemLen)
    
    -- Determine reduction at this time point
    local sibWindow = math.floor(tRel / detectionWindowSize) + 1
    local isSibilant = false
    if sibilanceMap and sibWindow >= 1 and sibWindow <= #sibilanceMap then
      isSibilant = sibilanceMap[sibWindow].isSibilant
    end
    
    local reduction_value = isSibilant and reductionLin or 1.0
    local scaled = reaper.ScaleToEnvelopeMode(1, reduction_value, env)
    reaper.InsertEnvelopePoint(env, tRel, scaled, 0, 0, false, true)
  end

  releaseAudioAccessor(take)
  reaper.Envelope_SortPoints(env)
  simplifyEnvelope(env)
  return true, (reaper.time_precise() - ts)
end

