local DEFAULT_FREQ_HIGH = 14000
local DEFAULT_THRESHOLD_RATIO = 0.40
local DEFAULT_REDUCTION = -6
local DEFAULT_ATTACK_TIME = 0.01
local DEFAULT_RELEASE_TIME = 0.1
