                  refreshWaveform()
                end
                sliderWasActive["freqLow"] = isActive
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Low Freq (Hz)")
                reaper.ImGui_Spacing(ctx)
      
                changed, newVal = reaper.ImGui_SliderInt(ctx, "##freqHigh", freqHigh, 1000, 20000)
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  freqHigh = DEFAULT_FREQ_HIGH
                  statusMessage = "Freq High reset"
                  refreshWaveform()
                elseif changed then
                  freqHigh = newVal
                  if freqLow >= freqHigh then freqLow = freqHigh - 1000 end
                end
                isActive = reaper.ImGui_IsItemActive(ctx)
                if sliderWasActive["freqHigh"] and not isActive then
                  refreshWaveform()
                end
                sliderWasActive["freqHigh"] = isActive
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "High Freq (Hz)")
                reaper.ImGui_Spacing(ctx)
      
                changed, newVal = reaper.ImGui_SliderDouble(ctx, "##thresholdRatio", thresholdRatio, 0.10, 1.0, "%.2f")
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  thresholdRatio = DEFAULT_THRESHOLD_RATIO
                  statusMessage = "Threshold Ratio reset"
                  refreshWaveform()
                elseif changed then
                  thresholdRatio = newVal
                end
                isActive = reaper.ImGui_IsItemActive(ctx)
                if sliderWasActive["thresholdRatio"] and not isActive then
                  refreshWaveform()
                end
                sliderWasActive["thresholdRatio"] = isActive
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Threshold Ratio")
                reaper.ImGui_Spacing(ctx)
                
                changed, newVal = reaper.ImGui_SliderDouble(ctx, "##reduction", reduction, -24, 0, "%.1f")
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  reduction = DEFAULT_REDUCTION
                  statusMessage = "Reduction reset"
                  refreshWaveform()
                elseif changed then
                  reduction = newVal
                end
                isActive = reaper.ImGui_IsItemActive(ctx)
                if sliderWasActive["reduction"] and not isActive then
                  refreshWaveform()
                end
                sliderWasActive["reduction"] = isActive
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Reduction (dB)")
      
                reaper.ImGui_PopItemWidth(ctx)
              reaper.ImGui_EndChild(ctx)
      
              reaper.ImGui_SameLine(ctx, 0, gap)
      
              reaper.ImGui_BeginChild(ctx, "controls_right_col", colWidth, 0, reaper.ImGui_WindowFlags_NoScrollbar())
                reaper.ImGui_PushItemWidth(ctx, colWidth * 0.60)
      
                local changed2, newVal2 = reaper.ImGui_SliderDouble(ctx, "##detectionMs", detectionMs, 1, 50, "%.0f")
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  detectionMs = DEFAULT_DETECTION_MS
                  statusMessage = "Detection reset"
                  refreshWaveform()
                elseif changed2 then
                  detectionMs = newVal2
                end
                isActive2 = reaper.ImGui_IsItemActive(ctx)
                if sliderWasActive["detectionMs"] and not isActive2 then
                  refreshWaveform()
                end
                sliderWasActive["detectionMs"] = isActive2
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Detection (ms)")
                reaper.ImGui_Spacing(ctx)
      
                changed2, newVal2 = reaper.ImGui_SliderDouble(ctx, "##envelopeMs", envelopeMs, 0.1, 5, "%.1f")
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  envelopeMs = DEFAULT_ENVELOPE_MS
                  statusMessage = "Envelope reset"
                elseif changed2 then
                  envelopeMs = newVal2
                end
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Envelope (ms)")
      
                reaper.ImGui_PopItemWidth(ctx)
              reaper.ImGui_EndChild(ctx)
            end
      
          elseif tabState.currentTab == 2 then
            -- DISPLAY TAB
            local gap = 28
            local colWidth = math.max(220, math.min(360, (contentWidth - gap) / 2))
            local totalControlsW = (colWidth * 2) + gap
            local leftPad = math.max(0, (contentWidth - totalControlsW) / 2)
      
            if contentWidth < 500 then
              reaper.ImGui_Text(ctx, "Window too narrow for display controls")
              reaper.ImGui_Spacing(ctx)
            else
              reaper.ImGui_Dummy(ctx, leftPad, 0)
              reaper.ImGui_SameLine(ctx)
      
              reaper.ImGui_BeginChild(ctx, "display_left_col", colWidth, 0, reaper.ImGui_WindowFlags_NoScrollbar())
                reaper.ImGui_PushItemWidth(ctx, colWidth * 0.60)
      
                local changed, newVal = reaper.ImGui_SliderInt(ctx, "##rawWaveformOpacity", rawWaveformOpacity, 0, 100)
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  rawWaveformOpacity = DEFAULT_RAW_WAVEFORM_OPACITY
                  statusMessage = "Raw Opacity reset"
                  waveformNeedsRedraw = true
                elseif changed then
                  rawWaveformOpacity = newVal
                  waveformNeedsRedraw = true
                end
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Raw Waveform Opacity (%)")
                reaper.ImGui_Spacing(ctx)
      
                changed, newVal = reaper.ImGui_SliderInt(ctx, "##numFreqBins", numFreqBins, 64, 512)
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  numFreqBins = DEFAULT_FREQ_PRECISION
                  statusMessage = "Freq Precision reset"
                  waveformNeedsRedraw = true
                elseif changed then
                  numFreqBins = newVal
                  waveformNeedsRedraw = true
                end
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Freq Precision (bins)")
                reaper.ImGui_Spacing(ctx)
      
                reaper.ImGui_PopItemWidth(ctx)
              reaper.ImGui_EndChild(ctx)
      
              reaper.ImGui_SameLine(ctx, 0, gap)
      
              reaper.ImGui_BeginChild(ctx, "display_right_col", colWidth, 0, reaper.ImGui_WindowFlags_NoScrollbar())
                reaper.ImGui_PushItemWidth(ctx, colWidth * 0.60)
      
                local changed2, newVal2 = reaper.ImGui_SliderDouble(ctx, "##sibilanceOpacity2", sibilanceOpacity, 0, 100, "%.0f%%")
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  sibilanceOpacity = DEFAULT_SIBILANCE_OPACITY
                  statusMessage = "Sibilance Opacity reset"
                  waveformNeedsRedraw = true
                elseif changed2 then
                  sibilanceOpacity = newVal2
                  waveformNeedsRedraw = true
                end
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Sibilance Opacity (%)")
                reaper.ImGui_Spacing(ctx)
      
                changed2, newVal2 = reaper.ImGui_SliderInt(ctx, "##numTimeBins", numTimeBins, 64, 512)
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  numTimeBins = DEFAULT_TIME_PRECISION
                  statusMessage = "Time Precision reset"
                  waveformNeedsRedraw = true
                elseif changed2 then
                  numTimeBins = newVal2
                  waveformNeedsRedraw = true
                end
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Time Precision (bins)")
                reaper.ImGui_Spacing(ctx)
                
                changed2, newVal2 = reaper.ImGui_SliderDouble(ctx, "##freqLogScaling", freqLogScaling, 1.0, 15.0, "%.1f")
                if reaper.ImGui_IsItemHovered(ctx) and reaper.ImGui_IsMouseClicked(ctx, 1) then
                  freqLogScaling = DEFAULT_FREQ_LOG_SCALING
                  statusMessage = "Freq Log Scaling reset"
                  waveformNeedsRedraw = true
                elseif changed2 then
                  freqLogScaling = newVal2
                  waveformNeedsRedraw = true
                end
                reaper.ImGui_SameLine(ctx)
                reaper.ImGui_Text(ctx, "Freq Log Scaling")
                reaper.ImGui_Spacing(ctx)
      
                reaper.ImGui_PopItemWidth(ctx)
              reaper.ImGui_EndChild(ctx)
            end
          end
        end
      end
    end

    -- Waveform rendering
    if waveformData and #waveformData > 0 then
      if lastPlotW ~= plotW or lastPlotH ~= plotH then waveformNeedsRedraw = true; lastPlotW, lastPlotH = plotW, plotH end
      if lastZoomLevel ~= zoomLevel or lastZoomCenter ~= zoomCenter then waveformNeedsRedraw = true; lastZoomLevel, lastZoomCenter = zoomLevel, zoomCenter end

      local x, y, w, h = getPinnedWaveformRect(plotH)
      local totalSamples = #waveformData
      local visibleSamples = math.max(50, math.floor(totalSamples / zoomLevel))
      local startSample = math.max(1, math.min(totalSamples - visibleSamples, math.floor(zoomCenter * totalSamples - visibleSamples / 2)))

      local mouse_x, mouse_y = reaper.ImGui_GetMousePos(ctx)
      local isInside = (mouse_x >= x and mouse_x <= x + w and mouse_y >= y and mouse_y <= y + h)

      -- Right-click to toggle display mode
      if isInside and reaper.ImGui_IsMouseClicked(ctx, 1) then
        displayMode = displayMode == "waveform" and "spectrogram" or "waveform"
        statusMessage = "Display mode: " .. displayMode
        waveformNeedsRedraw = true
      end

      -- Left-click to set edit cursor (single click)
      if isInside and reaper.ImGui_IsMouseClicked(ctx, 0) and not isDragging then
        -- Check if this is a drag start or just a click
        isDragging = true
        dragStartY = mouse_y
        dragStartZoom = zoomLevel
        local total = #waveformData
        local vis = math.max(50, math.floor(total / zoomLevel))
        local startSamp = math.max(1, math.min(total - vis, math.floor(zoomCenter * total - vis / 2)))
        local relX = (mouse_x - x) / w
        dragStartCursorSample = startSamp + relX * vis
      end

      if isDragging then
        if reaper.ImGui_IsMouseReleased(ctx, 0) then
          -- If barely moved, treat as click to set cursor
          local deltaY = math.abs(dragStartY - mouse_y)
          if deltaY < 5 then
            local item = reaper.GetSelectedMediaItem(0, 0)
            if item then
              local take = reaper.GetActiveTake(item)
              if take then
                local aa, aaStart, aaEnd, samplerate, itemLen = get_accessor_bounds(take)
                if aa then
                  -- Calculate which sample was clicked
                  local relX = (mouse_x - x) / w
                  local total = #waveformData
                  local vis = math.max(50, math.floor(total / zoomLevel))
                  local startSamp = math.max(1, math.min(total - vis, math.floor(zoomCenter * total - vis / 2)))
                  local samplePos = startSamp + relX * vis
                  local clickTime = (samplePos / total) * itemLen
                  
                  -- Get item position in project
                  local itemStart = reaper.GetMediaItemInfo_Value(item, "D_POSITION")
                  
                  -- Set edit cursor to the clicked position
                  local cursorPos = itemStart + clickTime
                  reaper.SetEditCurPos(cursorPos, false, false)
                  
                  statusMessage = string.format("Edit cursor set to %.3f", cursorPos)
                end
              end
            end
          end
          isDragging = false
        else
          -- Dragging - zoom
          local deltaY = dragStartY - mouse_y
          local zoomFactor = 1 + (deltaY / 100)
          local newZoom = math.max(1.0, math.min(100.0, dragStartZoom * zoomFactor))
          local total = #waveformData
          local newVis = math.max(50, math.floor(total / newZoom))
          local relX = (mouse_x - x) / w
          local newStart = dragStartCursorSample - relX * newVis
          newStart = math.max(1, math.min(total - newVis, newStart))
          zoomCenter = (newStart + newVis / 2) / total
          zoomCenter = math.max(0, math.min(1, zoomCenter))
          zoomLevel = newZoom
          waveformNeedsRedraw = true
        end
      end

      local fg = reaper.ImGui_GetForegroundDrawList(ctx)
      reaper.ImGui_DrawList_AddRectFilled(fg, x, y, x + w, y + h, 0x1A1A1AFF)
      
      -- Draw waveform or spectrogram based on mode
      if displayMode == "waveform" then
        drawWaveform(fg, rawWaveformData, waveformData, x, y, w, h, minDB, maxDB, curvePower, zoomLevel, zoomCenter, sibilanceOpacity, rawWaveformOpacity)
      else
        -- Spectrogram mode - compute if not cached
        if not waveformData.spectrogram then
          local item = reaper.GetSelectedMediaItem(0, 0)
          if item then
            local take = reaper.GetActiveTake(item)
            if take then
              -- Time the spectrogram computation
              local t0 = reaper.time_precise()
              waveformData.spectrogram = computeSpectrogram(take, item, numFreqBins, numTimeBins, freqLow, freqHigh)
              local spectroTime = reaper.time_precise() - t0
              statusMessage = string.format("Spectrogram computed in %.3fs", spectroTime)
            end
          end
        end
        
        if waveformData.spectrogram then
          local mouse_x, mouse_y = reaper.ImGui_GetMousePos(ctx)
          local cursorInfo = drawSpectrogram(fg, waveformData.spectrogram, x, y, w, h, minDB, maxDB, freqLow, freqHigh, zoomLevel, zoomCenter, mouse_x, mouse_y, freqLogScaling)
          
          if cursorInfo and displayMode == "spectrogram" then
            statusMessage = string.format("Freq: %.1f Hz | Amplitude: %.1f dB", cursorInfo.freq, cursorInfo.db)
          end
        end
      end
      
      reaper.ImGui_DrawList_AddRect(fg, x, y, x + w, y + h, 0x808080FF, 0, 0, 1)
      local item = reaper.GetSelectedMediaItem(0, 0)
      
      -- Draw playhead for both modes
      if item then
        local isPlaying = reaper.GetPlayState() & 1 == 1
        local cursorPos = isPlaying and reaper.GetPlayPosition() or reaper.GetCursorPosition()
        local itemStart = reaper.GetMediaItemInfo_Value(item, "D_POSITION")
        local itemLength = reaper.GetMediaItemInfo_Value(item, "D_LENGTH")
        local itemEnd = itemStart + itemLength
        
        if cursorPos >= itemStart and cursorPos <= itemEnd then
          local take = reaper.GetActiveTake(item)
          if take then
            local aa, aaStart, aaEnd, _, audioItemLen = get_accessor_bounds(take)
            if aa then
              local itemOffset = cursorPos - itemStart
              local samplePos = math.floor((itemOffset / audioItemLen) * totalSamples) + 1
              
              if samplePos >= startSample and samplePos <= startSample + visibleSamples then
                local xPos = x + ((samplePos - startSample) / visibleSamples) * w
                
                -- Draw playhead line (bright green)
                reaper.ImGui_DrawList_AddLine(fg, xPos, y, xPos, y + h, 0x00FF00FF, 2)
                reaper.ImGui_DrawList_AddLine(fg, xPos, y, xPos, y + h, 0x00FF0044, 4)
              end
            end
          end
        end
      
        if displayMode == "waveform" then
          drawTimeRuler(fg, item, x, y + h, w, rulerH, zoomLevel, zoomCenter, totalSamples, startSample, visibleSamples)
        end
      end
    else
      reaper.ImGui_Text(ctx, "No waveform - select item and click Refresh")
    end

    reaper.ImGui_End(ctx)
  end

  PopTheme()
  if open then reaper.defer(loop) end
end

loop()
